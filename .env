# Local dev on phone/simulator — do NOT set EXPO_PUBLIC_API_URL here.
# appfinity-tjgt.com only resolves on this Mac via /etc/hosts.
# Native dev auto-uses your Expo LAN IP on port 8001.
#
# Start API: cd ../tjgt && php artisan serve --host=0.0.0.0 --port=8001
EXPO_PUBLIC_API_PORT=8001
# EXPO_PUBLIC_API_URL=https://appfinity-tjgt.com/api/app
# EXPO_PUBLIC_DEV_API_HOST=192.168.x.x
