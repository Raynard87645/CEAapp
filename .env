# EXPO_PUBLIC_API_URL is the main API path (used in production builds).
# On device/simulator in dev, Mac-only hosts like appfinity-tjgt.com auto-rewrite to your Expo LAN IP.
#
# Start API: cd ../tjgt && php artisan serve --host=0.0.0.0 --port=8001
EXPO_PUBLIC_API_PORT=8001
EXPO_PUBLIC_API_URL=https://appfinity-tjgt.com/api/app
EXPO_PUBLIC_DEV_API_HOST=192.168.100.232
