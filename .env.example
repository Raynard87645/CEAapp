# Production API (public DNS). Use when the domain resolves outside your Mac.
# EXPO_PUBLIC_API_URL=https://appfinity-tjgt.com/api/app

# Local development: leave EXPO_PUBLIC_API_URL unset on device/simulator.
# The app auto-uses your Expo LAN IP on port 8001.
#
# Start the backend first:
#   cd ../tjgt && php artisan serve --host=0.0.0.0 --port=8001
#
# Optional overrides:
# EXPO_PUBLIC_DEV_API_HOST=192.168.50.149
# EXPO_PUBLIC_API_PORT=8001
