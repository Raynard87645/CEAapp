# Main API base URL (production builds; also defines the API path in dev).
# EXPO_PUBLIC_API_URL=https://appfinity-tjgt.com/api/app
#
# Native dev: Mac-only hostnames (e.g. appfinity-tjgt.com via /etc/hosts) auto-rewrite to your
# Expo LAN IP on port 8001. Leave unset to skip straight to LAN auto-detection.
#
# Start the backend first:
#   cd ../tjgt && php artisan serve --host=0.0.0.0 --port=8001
#
# Optional overrides (recommended on physical devices — use your Mac's LAN IP):
# EXPO_PUBLIC_DEV_API_HOST=192.168.100.232
# EXPO_PUBLIC_API_PORT=8001
